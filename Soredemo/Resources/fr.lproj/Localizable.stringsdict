<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ was written, but %lld frame(s) could not be drawn and are missing from it. (%@)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ a été écrit, mais %2$#@n@ (%3$@)</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld image n’a pas pu être dessinée et en est absente.</string>
			<key>other</key>
			<string>%lld images n’ont pas pu être dessinées et en sont absentes.</string>
		</dict>
	</dict>
	<key>%lld caption(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld sous-titre</string>
			<key>other</key>
			<string>%lld sous-titres</string>
		</dict>
	</dict>
	<key>%lld caption(s) from %lld word(s).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@c@ à partir de %2$#@w@.</string>
		<key>c</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld sous-titre</string>
			<key>other</key>
			<string>%lld sous-titres</string>
		</dict>
		<key>w</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld mot</string>
			<key>other</key>
			<string>%lld mots</string>
		</dict>
	</dict>
	<key>%lld line(s) could not be read (first at line %lld).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ (la première à la ligne %2$lld).</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ligne n’a pas pu être lue</string>
			<key>other</key>
			<string>%lld lignes n’ont pas pu être lues</string>
		</dict>
	</dict>
	<key>%lld overlapping cue(s) were trimmed.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld sous-titre qui se chevauchait a été raccourci.</string>
			<key>other</key>
			<string>%lld sous-titres qui se chevauchaient ont été raccourcis.</string>
		</dict>
	</dict>
	<key>%lld seconds</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld seconde</string>
			<key>other</key>
			<string>%lld secondes</string>
		</dict>
	</dict>
	<key>%lld segment(s) did not make it into the recording.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld segment n’est pas entré dans l’enregistrement.</string>
			<key>other</key>
			<string>%lld segments ne sont pas entrés dans l’enregistrement.</string>
		</dict>
	</dict>
	<key>%lld sentence(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld phrase</string>
			<key>other</key>
			<string>%lld phrases</string>
		</dict>
	</dict>
	<key>None of %lld cue(s) fall inside this edit.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Le %lld sous-titre ne tombe pas dans ce montage.</string>
			<key>other</key>
			<string>Aucun des %lld sous-titres ne tombe dans ce montage.</string>
		</dict>
	</dict>
	<key>Read %lld cue(s) from %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ depuis %2$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld sous-titre lu</string>
			<key>other</key>
			<string>%lld sous-titres lus</string>
		</dict>
	</dict>
	<key>Remove %lld Silent Span(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Supprimer %lld passage silencieux</string>
			<key>other</key>
			<string>Supprimer %lld passages silencieux</string>
		</dict>
	</dict>
	<key>Remove %lld Still Span(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Supprimer %lld passage immobile</string>
			<key>other</key>
			<string>Supprimer %lld passages immobiles</string>
		</dict>
	</dict>
	<key>Remove %lld silent stretch(es), %@ in all</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@, %2$@ au total</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Supprimer %lld passage silencieux</string>
			<key>other</key>
			<string>Supprimer %lld passages silencieux</string>
		</dict>
	</dict>
	<key>Remove %lld still stretch(es), %@ in all</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@, %2$@ au total</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Supprimer %lld passage immobile</string>
			<key>other</key>
			<string>Supprimer %lld passages immobiles</string>
		</dict>
	</dict>
	<key>Save the last %lld seconds — the recording keeps going</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Enregistrer la dernière seconde (%lld) — l’enregistrement continue</string>
			<key>other</key>
			<string>Enregistrer les %lld dernières secondes — l’enregistrement continue</string>
		</dict>
	</dict>
	<key>Saved the last %lld seconds to %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ dans %2$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>La dernière seconde (%lld) a été enregistrée</string>
			<key>other</key>
			<string>Les %lld dernières secondes ont été enregistrées</string>
		</dict>
	</dict>
	<key>The same change fits %lld other line(s).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>La même correction convient à %lld autre ligne.</string>
			<key>other</key>
			<string>La même correction convient à %lld autres lignes.</string>
		</dict>
	</dict>
	<key>Wrote %lld cue(s) to %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ dans %2$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld sous-titre écrit</string>
			<key>other</key>
			<string>%lld sous-titres écrits</string>
		</dict>
	</dict>
	<key>about %lld hours left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>il reste environ %lld heure</string>
			<key>other</key>
			<string>il reste environ %lld heures</string>
		</dict>
	</dict>
	<key>about %lld minutes left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>il reste environ %lld minute</string>
			<key>other</key>
			<string>il reste environ %lld minutes</string>
		</dict>
	</dict>
	<key>about %lld seconds left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>il reste environ %lld seconde</string>
			<key>other</key>
			<string>il reste environ %lld secondes</string>
		</dict>
	</dict>
</dict>
</plist>
