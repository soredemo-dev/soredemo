			<key>many</key>
			<string>%lld предложений</string>
			<key>other</key>
			<string>%lld предложения</string>
		</dict>
	</dict>
	<key>None of %lld cue(s) fall inside this edit.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Ни один из %lld субтитра не попадает в этот монтаж.</string>
			<key>few</key>
			<string>Ни один из %lld субтитров не попадает в этот монтаж.</string>
			<key>many</key>
			<string>Ни один из %lld субтитров не попадает в этот монтаж.</string>
			<key>other</key>
			<string>Ни один из %lld субтитров не попадает в этот монтаж.</string>
		</dict>
	</dict>
	<key>Read %lld cue(s) from %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Из %2$@ прочитано: %1$#@n@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld субтитр</string>
			<key>few</key>
			<string>%lld субтитра</string>
			<key>many</key>
			<string>%lld субтитров</string>
			<key>other</key>
			<string>%lld субтитра</string>
		</dict>
	</dict>
	<key>Remove %lld Silent Span(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Удалить %lld тихий фрагмент</string>
			<key>few</key>
