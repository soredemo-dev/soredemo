	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@, всего %2$@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Удалить %lld неподвижный фрагмент</string>
			<key>few</key>
			<string>Удалить %lld неподвижных фрагмента</string>
			<key>many</key>
			<string>Удалить %lld неподвижных фрагментов</string>
			<key>other</key>
			<string>Удалить %lld неподвижных фрагмента</string>
		</dict>
	</dict>
