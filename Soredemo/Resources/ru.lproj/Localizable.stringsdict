<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ was written, but %lld frame(s) could not be drawn and are missing from it. (%@)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Файл %1$@ записан, но %2$#@n@ (%3$@)</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld кадр не удалось отрисовать, и его в нём нет.</string>
			<key>few</key>
			<string>%lld кадра не удалось отрисовать, и их в нём нет.</string>
			<key>many</key>
			<string>%lld кадров не удалось отрисовать, и их в нём нет.</string>
			<key>other</key>
			<string>%lld кадра не удалось отрисовать, и их в нём нет.</string>
		</dict>
	</dict>
	<key>%lld caption(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld субтитр</string>
			<key>few</key>
			<string>%lld субтитра</string>
			<key>many</key>
			<string>%lld субтитров</string>
			<key>other</key>
			<string>%lld субтитра</string>
		</dict>
	</dict>
	<key>%lld caption(s) from %lld word(s).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@c@ из %2$#@w@.</string>
		<key>c</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld субтитр</string>
			<key>few</key>
			<string>%lld субтитра</string>
			<key>many</key>
			<string>%lld субтитров</string>
			<key>other</key>
			<string>%lld субтитра</string>
		</dict>
		<key>w</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld слова</string>
			<key>few</key>
			<string>%lld слов</string>
			<key>many</key>
			<string>%lld слов</string>
			<key>other</key>
			<string>%lld слов</string>
		</dict>
	</dict>
	<key>%lld line(s) could not be read (first at line %lld).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ (первая — строка %2$lld).</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Не удалось прочитать %lld строку</string>
			<key>few</key>
			<string>Не удалось прочитать %lld строки</string>
			<key>many</key>
			<string>Не удалось прочитать %lld строк</string>
			<key>other</key>
			<string>Не удалось прочитать %lld строки</string>
		</dict>
	</dict>
	<key>%lld overlapping cue(s) were trimmed.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
