	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Сохранить последнюю %lld секунду — запись продолжится</string>
			<key>few</key>
			<string>Сохранить последние %lld секунды — запись продолжится</string>
			<key>many</key>
			<string>Сохранить последние %lld секунд — запись продолжится</string>
			<key>other</key>
			<string>Сохранить последние %lld секунды — запись продолжится</string>
		</dict>
	</dict>
