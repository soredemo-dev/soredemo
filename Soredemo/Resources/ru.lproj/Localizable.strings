"Exporting %@" = "Экспорт %@";
"Open the caption editor" = "Открыть редактор субтитров";
"Captions at full width, with the waveform" = "Субтитры во всю ширину, с формой волны";
"split here" = "разделить здесь";
"merge with the line above" = "объединить со строкой выше";
"between lines" = "между строками";
