<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ was written, but %lld frame(s) could not be drawn and are missing from it. (%@)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已寫入 %1$@,但有 %2$#@n@(%3$@)</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 個影格無法繪製，檔案裡沒有它們。</string>
		</dict>
	</dict>
	<key>%lld caption(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句字幕</string>
		</dict>
	</dict>
	<key>%lld caption(s) from %lld word(s).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>從 %2$#@w@產生了 %1$#@c@。</string>
		<key>c</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句字幕</string>
		</dict>
		<key>w</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 個字</string>
		</dict>
	</dict>
	<key>%lld line(s) could not be read (first at line %lld).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>有 %1$#@n@無法讀取(第一處在第 %2$lld 行)。</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 行</string>
		</dict>
	</dict>
	<key>%lld overlapping cue(s) were trimmed.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>有 %lld 句重疊的字幕被裁短了。</string>
		</dict>
	</dict>
	<key>%lld seconds</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 秒</string>
		</dict>
	</dict>
	<key>%lld segment(s) did not make it into the recording.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>有 %lld 個片段沒有進到這次錄影裡。</string>
		</dict>
	</dict>
	<key>%lld sentence(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句</string>
		</dict>
	</dict>
	<key>None of %lld cue(s) fall inside this edit.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句字幕沒有一句落在這次編輯範圍內。</string>
		</dict>
	</dict>
	<key>Read %lld cue(s) from %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>從 %2$@ 讀取了 %1$#@n@。</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句字幕</string>
		</dict>
	</dict>
	<key>Remove %lld Silent Span(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>移除 %lld 段靜默</string>
		</dict>
	</dict>
	<key>Remove %lld Still Span(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>移除 %lld 段靜止</string>
		</dict>
	</dict>
	<key>Remove %lld silent stretch(es), %@ in all</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@,共 %2$@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>移除 %lld 段靜默</string>
		</dict>
	</dict>
	<key>Remove %lld still stretch(es), %@ in all</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@,共 %2$@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>移除 %lld 段靜止</string>
		</dict>
	</dict>
	<key>Save the last %lld seconds — the recording keeps going</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>儲存最後 %lld 秒 —— 錄影會繼續</string>
		</dict>
	</dict>
	<key>Saved the last %lld seconds to %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已把最後 %1$#@n@存成 %2$@。</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 秒</string>
		</dict>
	</dict>
	<key>The same change fits %lld other line(s).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>同樣的修改也適合另外 %lld 句。</string>
		</dict>
	</dict>
	<key>Wrote %lld cue(s) to %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已寫入 %1$#@n@到 %2$@。</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句字幕</string>
		</dict>
	</dict>
	<key>about %lld hours left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>大約還剩 %lld 小時</string>
		</dict>
	</dict>
	<key>about %lld minutes left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>大約還剩 %lld 分鐘</string>
		</dict>
	</dict>
	<key>about %lld seconds left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>大約還剩 %lld 秒</string>
		</dict>
	</dict>
</dict>
</plist>
