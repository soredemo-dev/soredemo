<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ was written, but %lld frame(s) could not be drawn and are missing from it. (%@)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已写入 %1$@,但有 %2$#@n@(%3$@)</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 个画面无法绘制，文件里没有它们。</string>
		</dict>
	</dict>
	<key>%lld caption(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句字幕</string>
		</dict>
	</dict>
	<key>%lld caption(s) from %lld word(s).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>从 %2$#@w@生成了 %1$#@c@。</string>
		<key>c</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句字幕</string>
		</dict>
		<key>w</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 个字</string>
		</dict>
	</dict>
	<key>%lld line(s) could not be read (first at line %lld).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>有 %1$#@n@无法读取(第一处在第 %2$lld 行)。</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 行</string>
		</dict>
	</dict>
	<key>%lld overlapping cue(s) were trimmed.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>有 %lld 句重叠的字幕被裁短了。</string>
		</dict>
	</dict>
	<key>%lld seconds</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 秒</string>
		</dict>
	</dict>
	<key>%lld segment(s) did not make it into the recording.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>有 %lld 个片段没有进到这次录制里。</string>
		</dict>
	</dict>
	<key>%lld sentence(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句</string>
		</dict>
	</dict>
	<key>None of %lld cue(s) fall inside this edit.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句字幕没有一句落在这次编辑范围内。</string>
		</dict>
	</dict>
	<key>Read %lld cue(s) from %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>从 %2$@ 读取了 %1$#@n@。</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句字幕</string>
		</dict>
	</dict>
	<key>Remove %lld Silent Span(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>移除 %lld 段静默</string>
		</dict>
	</dict>
	<key>Remove %lld Still Span(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>移除 %lld 段静止</string>
		</dict>
	</dict>
	<key>Remove %lld silent stretch(es), %@ in all</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@,共 %2$@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>移除 %lld 段静默</string>
		</dict>
	</dict>
	<key>Remove %lld still stretch(es), %@ in all</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@,共 %2$@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>移除 %lld 段静止</string>
		</dict>
	</dict>
	<key>Save the last %lld seconds — the recording keeps going</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>保存最后 %lld 秒 —— 录制会继续</string>
		</dict>
	</dict>
	<key>Saved the last %lld seconds to %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已把最后 %1$#@n@存成 %2$@。</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 秒</string>
		</dict>
	</dict>
	<key>The same change fits %lld other line(s).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>同样的修改也适合另外 %lld 句。</string>
		</dict>
	</dict>
	<key>Wrote %lld cue(s) to %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已写入 %1$#@n@到 %2$@。</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 句字幕</string>
		</dict>
	</dict>
	<key>about %lld hours left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>大约还剩 %lld 小时</string>
		</dict>
	</dict>
	<key>about %lld minutes left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>大约还剩 %lld 分钟</string>
		</dict>
	</dict>
	<key>about %lld seconds left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>大约还剩 %lld 秒</string>
		</dict>
	</dict>
</dict>
</plist>
