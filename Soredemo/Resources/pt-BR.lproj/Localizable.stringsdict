<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ was written, but %lld frame(s) could not be drawn and are missing from it. (%@)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ foi gravado, mas %2$#@n@ (%3$@)</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld quadro não pôde ser desenhado e está faltando nele.</string>
			<key>other</key>
			<string>%lld quadros não puderam ser desenhados e estão faltando nele.</string>
		</dict>
	</dict>
	<key>%lld caption(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld legenda</string>
			<key>other</key>
			<string>%lld legendas</string>
		</dict>
	</dict>
	<key>%lld caption(s) from %lld word(s).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@c@ a partir de %2$#@w@.</string>
		<key>c</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld legenda</string>
			<key>other</key>
			<string>%lld legendas</string>
		</dict>
		<key>w</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld palavra</string>
			<key>other</key>
			<string>%lld palavras</string>
		</dict>
	</dict>
	<key>%lld line(s) could not be read (first at line %lld).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ (a primeira na linha %2$lld).</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Não foi possível ler %lld linha</string>
			<key>other</key>
			<string>Não foi possível ler %lld linhas</string>
		</dict>
	</dict>
	<key>%lld overlapping cue(s) were trimmed.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld legenda sobreposta foi encurtada.</string>
			<key>other</key>
			<string>%lld legendas sobrepostas foram encurtadas.</string>
		</dict>
	</dict>
	<key>%lld seconds</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld segundo</string>
			<key>other</key>
			<string>%lld segundos</string>
		</dict>
	</dict>
	<key>%lld segment(s) did not make it into the recording.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld segmento não entrou na gravação.</string>
			<key>other</key>
			<string>%lld segmentos não entraram na gravação.</string>
		</dict>
	</dict>
	<key>%lld sentence(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld frase</string>
			<key>other</key>
			<string>%lld frases</string>
		</dict>
	</dict>
	<key>None of %lld cue(s) fall inside this edit.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>A %lld legenda não cai dentro deste corte.</string>
			<key>other</key>
			<string>Nenhuma das %lld legendas cai dentro deste corte.</string>
		</dict>
	</dict>
	<key>Read %lld cue(s) from %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ de %2$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld legenda lida</string>
			<key>other</key>
			<string>%lld legendas lidas</string>
		</dict>
	</dict>
	<key>Remove %lld Silent Span(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Remover %lld trecho em silêncio</string>
			<key>other</key>
			<string>Remover %lld trechos em silêncio</string>
		</dict>
	</dict>
	<key>Remove %lld Still Span(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Remover %lld trecho parado</string>
			<key>other</key>
			<string>Remover %lld trechos parados</string>
		</dict>
	</dict>
	<key>Remove %lld silent stretch(es), %@ in all</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@, %2$@ no total</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Remover %lld trecho em silêncio</string>
			<key>other</key>
			<string>Remover %lld trechos em silêncio</string>
		</dict>
	</dict>
	<key>Remove %lld still stretch(es), %@ in all</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@, %2$@ no total</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Remover %lld trecho parado</string>
			<key>other</key>
			<string>Remover %lld trechos parados</string>
		</dict>
	</dict>
	<key>Save the last %lld seconds — the recording keeps going</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Salvar o último %lld segundo — a gravação continua</string>
			<key>other</key>
			<string>Salvar os últimos %lld segundos — a gravação continua</string>
		</dict>
	</dict>
	<key>Saved the last %lld seconds to %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ em %2$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>O último %lld segundo foi salvo</string>
			<key>other</key>
			<string>Os últimos %lld segundos foram salvos</string>
		</dict>
	</dict>
	<key>The same change fits %lld other line(s).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>A mesma alteração serve para %lld outra linha.</string>
			<key>other</key>
			<string>A mesma alteração serve para %lld outras linhas.</string>
		</dict>
	</dict>
	<key>Wrote %lld cue(s) to %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ em %2$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld legenda escrita</string>
			<key>other</key>
			<string>%lld legendas escritas</string>
		</dict>
	</dict>
	<key>about %lld hours left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>resta cerca de %lld hora</string>
			<key>other</key>
			<string>restam cerca de %lld horas</string>
		</dict>
	</dict>
	<key>about %lld minutes left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>resta cerca de %lld minuto</string>
			<key>other</key>
			<string>restam cerca de %lld minutos</string>
		</dict>
	</dict>
	<key>about %lld seconds left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>resta cerca de %lld segundo</string>
			<key>other</key>
			<string>restam cerca de %lld segundos</string>
		</dict>
	</dict>
</dict>
</plist>
