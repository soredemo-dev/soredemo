<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ was written, but %lld frame(s) could not be drawn and are missing from it. (%@)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Se escribió %1$@, pero %2$#@n@ (%3$@)</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>no se pudo dibujar %lld fotograma y falta en el archivo.</string>
			<key>other</key>
			<string>no se pudieron dibujar %lld fotogramas y faltan en el archivo.</string>
		</dict>
	</dict>
	<key>%lld caption(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld subtítulo</string>
			<key>other</key>
			<string>%lld subtítulos</string>
		</dict>
	</dict>
	<key>%lld caption(s) from %lld word(s).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@c@ a partir de %2$#@w@.</string>
		<key>c</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld subtítulo</string>
			<key>other</key>
			<string>%lld subtítulos</string>
		</dict>
		<key>w</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld palabra</string>
			<key>other</key>
			<string>%lld palabras</string>
		</dict>
	</dict>
	<key>%lld line(s) could not be read (first at line %lld).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ (la primera en la línea %2$lld).</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>No se pudo leer %lld línea</string>
			<key>other</key>
			<string>No se pudieron leer %lld líneas</string>
		</dict>
	</dict>
	<key>%lld overlapping cue(s) were trimmed.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Se recortó %lld subtítulo superpuesto.</string>
			<key>other</key>
			<string>Se recortaron %lld subtítulos superpuestos.</string>
		</dict>
	</dict>
	<key>%lld seconds</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld segundo</string>
			<key>other</key>
			<string>%lld segundos</string>
		</dict>
	</dict>
	<key>%lld segment(s) did not make it into the recording.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld segmento no llegó a la grabación.</string>
			<key>other</key>
			<string>%lld segmentos no llegaron a la grabación.</string>
		</dict>
	</dict>
	<key>%lld sentence(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld frase</string>
			<key>other</key>
			<string>%lld frases</string>
		</dict>
	</dict>
	<key>None of %lld cue(s) fall inside this edit.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>El %lld subtítulo no cae dentro de este montaje.</string>
			<key>other</key>
			<string>Ninguno de los %lld subtítulos cae dentro de este montaje.</string>
		</dict>
	</dict>
	<key>Read %lld cue(s) from %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Se %1$#@n@ de %2$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>leyó %lld subtítulo</string>
			<key>other</key>
			<string>leyeron %lld subtítulos</string>
		</dict>
	</dict>
	<key>Remove %lld Silent Span(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Eliminar %lld tramo en silencio</string>
			<key>other</key>
			<string>Eliminar %lld tramos en silencio</string>
		</dict>
	</dict>
	<key>Remove %lld Still Span(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Eliminar %lld tramo inmóvil</string>
			<key>other</key>
			<string>Eliminar %lld tramos inmóviles</string>
		</dict>
	</dict>
	<key>Remove %lld silent stretch(es), %@ in all</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@, %2$@ en total</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Eliminar %lld tramo en silencio</string>
			<key>other</key>
			<string>Eliminar %lld tramos en silencio</string>
		</dict>
	</dict>
	<key>Remove %lld still stretch(es), %@ in all</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@, %2$@ en total</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Eliminar %lld tramo inmóvil</string>
			<key>other</key>
			<string>Eliminar %lld tramos inmóviles</string>
		</dict>
	</dict>
	<key>Save the last %lld seconds — the recording keeps going</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Guardar el último %lld segundo: la grabación continúa</string>
			<key>other</key>
			<string>Guardar los últimos %lld segundos: la grabación continúa</string>
		</dict>
	</dict>
	<key>Saved the last %lld seconds to %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Se %1$#@n@ en %2$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>guardó el último %lld segundo</string>
			<key>other</key>
			<string>guardaron los últimos %lld segundos</string>
		</dict>
	</dict>
	<key>The same change fits %lld other line(s).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>El mismo cambio encaja en %lld línea más.</string>
			<key>other</key>
			<string>El mismo cambio encaja en %lld líneas más.</string>
		</dict>
	</dict>
	<key>Wrote %lld cue(s) to %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@ en %2$@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld subtítulo escrito</string>
			<key>other</key>
			<string>%lld subtítulos escritos</string>
		</dict>
	</dict>
	<key>about %lld hours left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>queda aproximadamente %lld hora</string>
			<key>other</key>
			<string>quedan unas %lld horas</string>
		</dict>
	</dict>
	<key>about %lld minutes left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>queda aproximadamente %lld minuto</string>
			<key>other</key>
			<string>quedan unos %lld minutos</string>
		</dict>
	</dict>
	<key>about %lld seconds left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>queda aproximadamente %lld segundo</string>
			<key>other</key>
			<string>quedan unos %lld segundos</string>
		</dict>
	</dict>
</dict>
</plist>
