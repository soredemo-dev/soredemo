<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>SoredemoSpikeE</string>
	<!-- Its own identifier, like every spike: a TCC grant binds to the bundle
	     identifier, and no throwaway tool may lend or borrow the product's.
	     This spike happens to need no grant at all — it writes synthetic
	     frames to a temporary directory — but the rule is about what a binary
	     COULD hold, not what this one asks for. -->
	<key>CFBundleIdentifier</key><string>video.soredemo.SpikeE</string>
	<key>CFBundleName</key><string>SoredemoSpikeE</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>LSMinimumSystemVersion</key><string>26.0</string>
	<key>LSUIElement</key><true/>
</dict>
</plist>
