<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>SoredemoSpikeC</string>
	<!-- Its own identifier, not the product's — the same reasoning Spike A and
	     Spike B carry. `capture-permissions` has to verify that each permission
	     degrades precisely, which needs a testable first-run flow, and a
	     throwaway spike holding an Input Monitoring grant under
	     video.soredemo.Soredemo would destroy that state silently.

	     It matters more here than for either of them: Input Monitoring is
	     granted per binary and the grant is remembered by code-signing
	     identity, so re-running this after an edit prompts again. That is the
	     intended cost. -->
	<key>CFBundleIdentifier</key><string>video.soredemo.SpikeC</string>
	<key>CFBundleName</key><string>SoredemoSpikeC</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>LSMinimumSystemVersion</key><string>26.0</string>
	<key>LSUIElement</key><true/>
</dict>
</plist>
