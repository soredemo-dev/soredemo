<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>SoredemoSpikeB</string>
	<!-- Its own identifier, not the product's. capture-permissions has to verify
	     that each permission degrades precisely, which needs a testable first-run
	     flow — a throwaway spike holding a grant under dev.soredemo.mac
	     would destroy that state silently. Same reasoning as Spike A. -->
	<key>CFBundleIdentifier</key><string>video.soredemo.SpikeB</string>
	<key>CFBundleName</key><string>SoredemoSpikeB</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>LSMinimumSystemVersion</key><string>26.0</string>
	<key>LSUIElement</key><true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Measures whether screen recording keeps system audio and the microphone as separate tracks.</string>
</dict>
</plist>
